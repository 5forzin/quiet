{
  "name": "quiet-desktop-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "A local browser agent workspace on a separate Windows desktop, with session consent and live preview.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node src/server.mjs",
    "start:background": "node scripts/start-background.mjs",
    "setup:preview": "node scripts/setup-preview.mjs",
    "setup:mini": "node scripts/setup-mini.mjs",
    "setup:workspace": "node scripts/setup-workspace.mjs",
    "docs:capture": "node scripts/capture-docs.mjs",
    "preview": "node scripts/open-preview.mjs",
    "cli": "node src/cli.mjs",
    "mcp": "node src/mcp.mjs",
    "test": "node --test test/unit.test.mjs",
    "test:mini": "node scripts/setup-mini.mjs && node --test test/mini.test.mjs",
    "test:pointer": "node --test test/pointer.test.mjs",
    "test:integration": "node --test --test-concurrency=1 test/integration.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@phosphor-icons/core": "2.1.1",
    "ghost-cursor": "^1.4.2",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
