{
  "manifest_version": 3,
  "name": "Quiet Desktop Session Bridge",
  "version": "0.2.0",
  "description": "Authorize selected browser sessions for your local agent desktop.",
  "minimum_chrome_version": "120",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Quiet Desktop" },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:9467"
  }
}
